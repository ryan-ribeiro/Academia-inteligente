POSTGRES_DB=academia_inteligente
POSTGRES_USER=academia
POSTGRES_PASSWORD=replace-with-a-local-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
KEYCLOAK_PROVISIONING_CLIENT_SECRET=replace-with-a-local-provisioning-secret
KEYCLOAK_HOSTNAME=localhost
# Set to 0.0.0.0 only for testing from another device on your trusted LAN.
LOCAL_BIND_ADDRESS=127.0.0.1
# For HTTPS testing from a phone, set this to /api and use docker-compose.lan-https.yml.
VITE_DEV_HTTPS=false
DEV_CERT_DIR=/tmp/academia-inteligente-certificates
APP_ADMIN_USERNAME=replace-with-an-admin-username
APP_ADMIN_PASSWORD=replace-with-a-local-password
# Local demo accounts are created automatically; never enable in production.
SEED_DEMO_ACCOUNTS=true
DEMO_ACCOUNT_PASSWORD=123
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ACCESS_EVENT_INTEGRATION_SECRET=replace-with-a-local-access-event-secret
VITE_OIDC_ISSUER=http://localhost:8080/realms/academia
VITE_OIDC_CLIENT_ID=academia-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
SMTP_FROM=no-reply@academia.local
ONBOARDING_INVITATION_URL=http://localhost:5173/onboarding
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=10
AI_RECENT_MESSAGE_LIMIT=6
# RAG embeddings use a dedicated internal BGE-M3 Ollama service initialized by Compose.
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=120
# Local Ollama alternative. Set AI_PROVIDER=ollama to use these values; no OpenAI key is needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
# Optional internal Docker Ollama service; start with: docker compose --profile ollama up -d
OLLAMA_DOCKER_TAG=0.34.1
# The bundled CUDA 13 runtime detects the local NVIDIA GPU; override for a different driver.
OLLAMA_LLM_LIBRARY=cuda_v13
# Keep f16 unless profiling shows VRAM pressure; q8_0 reduces context-cache memory.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=f16

# Local owner-only facial pilot. Provider network has no outbound route.
FACIAL_ACCESS_MODE=disabled
COMPREFACE_DATABASE_PASSWORD=
COMPREFACE_API_KEY=
BIOMETRIC_DETECTION_THRESHOLD=0.90
BIOMETRIC_MATCH_THRESHOLD=0.80
BIOMETRIC_AMBIGUITY_MARGIN=0.10
BIOMETRIC_TIMEOUT_SECONDS=10
