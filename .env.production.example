# Reference only. Use docs/deployment/prepare.py to generate private state and an env file.
APP_DOMAIN=gym.example.com
PRODUCTION_STATE_DIR=./.deployment
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=gym@example.com
SMTP_FROM=gym@example.com
KEYCLOAK_ADMIN_USERNAME=identity-admin
AI_PROVIDER=openai
# Independent RAG embedding timeout; writing provider selection is unchanged.
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=120
OPENAI_MODEL=gpt-5.6-luna
FACIAL_ACCESS_MODE=disabled
# Existing local biometric pilot remains optional and unchanged; configure before using registration.
# COMPREFACE_DATABASE_PASSWORD is generated privately by prepare.py for that optional profile.
